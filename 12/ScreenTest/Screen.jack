/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 512 columns by 256 rows.
 */
class Screen {
    static boolean color;
    static Array powersOfTwo; // Local array for fast bit-masking

    /** Initializes the Screen. */
    function void init() {
        var int i, p;
        let powersOfTwo = Array.new(16);
        let i = 0;
        let p = 1;
        while (i < 16) {
            let powersOfTwo[i] = p;
            let p = p + p; // Efficiently build powers of 2
            let i = i + 1;
        }
        
        do Screen.setColor(true); // Default to black
        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var int i;
        let i = 0;
        while (i < 8192) {
            do Memory.poke(16384 + i, 0); 
            let i = i + 1;
        }
        return;
    }

    /** Sets the current color. */
    function void setColor(boolean b) {
        let color = b;
        return;
    }

    /** Draws the (x,y) pixel. */
    function void drawPixel(int x, int y) {
        var int address, value, mask;
        
        if ((x < 0) | (x > 511) | (y < 0) | (y > 255)) { return; }

        let address = 16384 + (y * 32) + (x / 16);
        let value = Memory.peek(address);
        
        // Use the local Screen array
        let mask = powersOfTwo[x & 15]; 
        
        if (color) {
            let value = value | mask;
        } else {
            let value = value & (~mask);
        }
        
        do Memory.poke(address, value);
        return;
    }

    /** Draws a line using Bresenham's-style algorithm. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int dx, dy, a, b, diff, temp;
        
        if (x1 > x2) {
            do Screen.drawLine(x2, y2, x1, y1);
            return;
        }

        let dx = x2 - x1;
        let dy = y2 - y1;
        let a = 0;
        let b = 0;
        let diff = 0;

        if (dx = 0) {
            if (y2 < y1) { let temp = y1; let y1 = y2; let y2 = temp; }
            while (~(y1 > y2)) {
                do Screen.drawPixel(x1, y1);
                let y1 = y1 + 1;
            }
            return;
        }

        if (dy = 0) {
            while (~(a > dx)) {
                do Screen.drawPixel(x1 + a, y1);
                let a = a + 1;
            }
            return;
        }

        if (dy > 0) {
            while (~(a > dx) & ~(b > dy)) {
                do Screen.drawPixel(x1 + a, y1 + b);
                if (diff < 0) { 
                    let a = a + 1; 
                    let diff = diff + dy; 
                } else { 
                    let b = b + 1; 
                    let diff = diff - dx; 
                }
            }
        } else {
            while (~(a > dx) & ~(b < dy)) {
                do Screen.drawPixel(x1 + a, y1 + b);
                if (diff < 0) { 
                    let a = a + 1; 
                    let diff = diff - dy; 
                } else { 
                    let b = b - 1; 
                    let diff = diff - dx; 
                }
            }
        }
        return;
    }

    /** Draws a filled rectangle. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        var int topY, bottomY, leftX, rightX, currentY;

        let leftX = Math.min(x1, x2);
        let rightX = Math.max(x1, x2);
        let topY = Math.min(y1, y2);
        let bottomY = Math.max(y1, y2);
        let currentY = topY;

        while (~(currentY > bottomY)) {
            do Screen.drawLine(leftX, currentY, rightX, currentY);
            let currentY = currentY + 1;
        }
        return;
    }

    /** Draws a hollow circle. */
    function void drawCircle(int x, int y, int r) {
        var int dy, rSquared, x_offset;

        if (r > 181) { let r = 181; }
        if (r < 0) { return; }

        let rSquared = r * r;
        let dy = -r;

        while (~(dy > r)) {
            let x_offset = Math.sqrt(rSquared - (dy * dy));
            do Screen.drawSafePixel(x - x_offset, y + dy);
            do Screen.drawSafePixel(x + x_offset, y + dy);
            let dy = dy + 1;
        }
        return;
    }

    /** Helper to ensure we don't poke memory outside the screen range. */
    function void drawSafePixel(int x, int y) {
        if ((x < 0) | (x > 511) | (y < 0) | (y > 255)) { return; }
        do Screen.drawPixel(x, y);
        return;
    }
}