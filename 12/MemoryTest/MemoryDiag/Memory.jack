/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
	static Array freeList;
	
	static Array ram;
    /** Initializes the class. */
    function void init() {
		let ram = 0;
		
		let freeList=2048;
		let freeList[1] = 14335; // Total heap size (16383 - 2048)
        let freeList[0] = 0;     // Next pointer (null)
		return;
    }
	

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
		  return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
		let ram[address]= value;
		return;
    }

	/** Finds an available RAM block of the given size and returns
     * a reference to its base address. */
	 //well use the first fit algorithm
    function Array alloc(int size) {
        var Array curr;
        var int foundBlock;

        let curr = freeList; // Start searching at the head of the freeList

        // Iterate through the linked list of free blocks
        while (~(curr = 0)) {
            // Check if the current block has enough room (size + 2 for header)
            if (curr[1] > (size + 1)) {
                
                
                let foundBlock = (curr + curr[1]) - size;
                
                
                let ram[foundBlock - 1] = size;
                let ram[foundBlock - 2] = 0; 
                
                
                let curr[1] = curr[1] - (size + 2);
                
                return foundBlock;
            }

            // Move to the next block in the list
            let curr = curr[0]; 
        }

        // If we reach here, no block was large enough
        return 0; 
    }
	/** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
		//we know that in each allocated block we have the header : size and null pointer (because it was allocated)
      var Array segment;
      let segment=o-2;
      //size is already dealt with in segment[1] we only change pointers
      let segment[0]=freeList; //make sure than the new segment points to the prevous head
      let freeList=segment; //segment is head

      return;
		
    }
}
